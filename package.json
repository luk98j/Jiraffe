{
  "name": "jiraffe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "tsx packages/server/src/main.ts",
    "db:generate": "pnpm --filter @jiraffe/db db:generate",
    "dev": "pnpm --parallel --filter @jiraffe/server --filter @jiraffe/web run dev"
  },
  "devDependencies": {
    "@jiraffe/core": "workspace:*",
    "@jiraffe/engine": "workspace:*",
    "@jiraffe/jira": "workspace:*",
    "@jiraffe/server": "workspace:*",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
